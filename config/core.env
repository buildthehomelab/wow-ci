# Core the server runs (copied from wow-server/manifest/core.tsv). The core and
# mod-playerbots are our forks: branch evermore = upstream + our own commits.
CORE_REPO=https://github.com/buildthehomelab/wow-azerothcore.git
CORE_BRANCH=evermore
CORE_REF=45a31ad06fffc4662ba8e0b10ce8337b83d2ffeb
PLAYERBOTS_REPO=https://github.com/buildthehomelab/wow-mod-playerbots.git
PLAYERBOTS_BRANCH=evermore
PLAYERBOTS_REF=a0de40f17f4fe01af8a7dda95bedc61bde08e6c0
# What the forks follow (upstream watch merges these into evermore).
CORE_UPSTREAM_REPO=https://github.com/mod-playerbots/azerothcore-wotlk.git
CORE_UPSTREAM_BRANCH=Playerbot
PLAYERBOTS_UPSTREAM_REPO=https://github.com/mod-playerbots/mod-playerbots.git
PLAYERBOTS_UPSTREAM_BRANCH=master
